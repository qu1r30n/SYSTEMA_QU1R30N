{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SISTEMA_QU1R30N (Debug completo)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\build_debug.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila todo el proyecto y genera bin\\sistema_qu1r30n_debug.exe."
        }
    ]
}